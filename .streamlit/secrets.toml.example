# Sao chép tệp này thành `.streamlit/secrets.toml` khi cần cấu hình storage.
# Gemini luôn dùng BYOK: người dùng nhập API key trong sidebar cho từng session.

STORAGE_MODE = "local"
QDRANT_PATH = ".data/qdrant"

# Chỉ cần cho chế độ cloud.
QDRANT_URL = ""
QDRANT_API_KEY = ""

# Có thể ghi đè model sau khi benchmark, không cần sửa mã nguồn.
CHAT_MODEL = "gemini-3.5-flash-lite"
EMBEDDING_MODEL = "gemini-embedding-2"
EMBEDDING_DIMENSION = 768

# Resource bounds cho ingestion.
MAX_UPLOAD_MB = 25
MAX_DOCUMENT_PAGES = 300
MAX_EXTRACTED_CHARS = 2000000
MAX_ZIP_ENTRIES = 4000
MAX_ZIP_UNCOMPRESSED_MB = 100
CHUNK_SIZE_CHARS = 1600
CHUNK_OVERLAP_CHARS = 240
CONTEXT_PREFIX_CHARS = 360
MAX_LLM_CONTEXT_CHUNKS = 40
EMBEDDING_BATCH_SIZE = 50
EMBEDDING_MAX_RETRIES = 2
