# Sao chép tệp này thành `.streamlit/secrets.toml` khi cần cấu hình storage.
# Gemini luôn dùng BYOK: người dùng nhập API key trong sidebar cho từng session.

STORAGE_MODE = "local"
QDRANT_PATH = ".data/qdrant"

# Chỉ cần cho chế độ cloud.
QDRANT_URL = ""
QDRANT_API_KEY = ""

# Có thể ghi đè model sau khi benchmark, không cần sửa mã nguồn.
CHAT_MODEL = "gemini-3.7-flash"
EMBEDDING_MODEL = "gemini-embedding-2"
